<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.10</version>
    <relativePath/>
  </parent>

  <!-- Single root POM for both deliverables: the word-count console CLI
       (src/main/java/WordCount.java, default package, target/classes)
       and the Spring Boot REST service (dev.kanban.wordcount). Maven
       allows one POM per directory, so the CLI builds from this POM too. -->

  <groupId>dev.kanban</groupId>
  <artifactId>wordcount-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>wordcount-service</name>
  <description>Word-count REST service (POST /count) + word-count console CLI (shared root POM)</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
